// Sample Night: a small synthetic VS Code theme for the importer tests.
{
  "$schema": "vscode://schemas/color-theme",
  "name": "Sample Night", // trailing line comment
  "type": "dark",
  /* block comment with "quotes", a // and a trailing comma, */
  "colors": {
    "editor.background": "#1b1d2b",
    "editor.foreground": "#c8d0e0",
    "sideBar.background": "#161825",
    "editorWidget.background": "#1f2233",
    "focusBorder": "#7aa2f7",
    "button.background": "#3d59a1",
    "editor.selectionBackground": "#7aa2f733",
    "editorCursor.foreground": "#ffcc66",
    "textLink.foreground": "#73daca",
    "descriptionForeground": "#8089a8",
    "editorError.foreground": "#f7768e",
    "terminal.ansiBlack": "#15161e",
    "terminal.ansiRed": "#f7768e",
    "terminal.ansiGreen": "#9ece6a",
    "terminal.ansiYellow": "#e0af68",
    "terminal.ansiBlue": "#7aa2f7",
    "terminal.ansiMagenta": "#bb9af7",
    "terminal.ansiCyan": "#7dcfff",
    "terminal.ansiWhite": "#a9b1d6",
    "terminal.ansiBrightBlack": "#414868",
    "terminal.ansiBrightRed": "#ff899d",
    "terminal.ansiBrightGreen": "#9fe044",
    "terminal.ansiBrightYellow": "#faba4a",
    "terminal.ansiBrightBlue": "#8db0ff",
    "terminal.ansiBrightMagenta": "#c7a9ff",
    "terminal.ansiBrightCyan": "#a4daff",
    "terminal.ansiBrightWhite": "#c0caf5",
  },
  "tokenColors": [
    { "name": "Comment // not a comment", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#565f89", "fontStyle": "italic" } },
    { "scope": "string, string.quoted", "settings": { "foreground": "#9ece6a" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#ff9e64" } },
    { "scope": ["keyword", "storage.type"], "settings": { "foreground": "#bb9af7" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#89ddff" } },
    { "scope": "source.js keyword", "settings": { "foreground": "#ff0000" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#7aa2f7" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#2ac3de" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#f7768e" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#73daca" } },
    { "name": "https://example.com/*not-a-comment*/", "scope": "variable", "settings": { "foreground": "#c0caf5" } },
  ],
}
