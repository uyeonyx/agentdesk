{
  "name": "agentdesk",
  "version": "0.2.6",
  "description": "One inbox for all your coding agents (Claude Code, Codex) across projects. Desktop app for macOS and Windows: real terminals, git worktrees.",
  "main": "desktop/main.js",
  "scripts": {
    "build": "node ui/build.mjs",
    "dev": "node ui/build.mjs && AGENTDESK_HOME=${AGENTDESK_HOME:-$HOME/.agentdesk-dev} electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "playwright test",
    "dist": "node ui/build.mjs && electron-builder"
  },
  "author": "uyeon",
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@tabler/icons-webfont": "^3.49.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "d2coding": "^1.3.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "preact": "^11.0.1",
    "pretendard": "^1.3.9"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "productName": "Agent Desk"
}
