{
  "name": "agentdesk",
  "version": "0.3.0",
  "description": "One inbox for all your coding agents (Claude Code, Codex) across projects. Desktop app for macOS and Windows: real terminals, git worktrees.",
  "main": "desktop/main.js",
  "scripts": {
    "build": "node ui/build.mjs",
    "dev": "node ui/build.mjs && AGENTDESK_HOME=${AGENTDESK_HOME:-$HOME/.agentdesk-dev} electron .",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit test/*.test.js",
    "test:e2e": "playwright test",
    "dist": "node ui/build.mjs && electron-builder"
  },
  "author": "uyeon",
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tabler/icons-webfont": "^3.49.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "d2coding": "^1.3.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "preact": "^11.0.1",
    "pretendard": "^1.3.9"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  },
  "productName": "Agent Desk",
  "build": {
    "appId": "dev.uyeon.agentdesk",
    "productName": "Agent Desk",
    "artifactName": "AgentDesk-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "ui/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty-*/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Agent Desk는 문서 폴더 안의 저장소에서 에이전트를 실행하고 변경 사항을 보여 줘요.",
        "NSDesktopFolderUsageDescription": "Agent Desk는 데스크탑 폴더 안의 저장소에서 에이전트를 실행하고 변경 사항을 보여 줘요.",
        "NSDownloadsFolderUsageDescription": "Agent Desk는 다운로드 폴더 안의 저장소에서 에이전트를 실행하고 변경 사항을 보여 줘요.",
        "NSRemovableVolumesUsageDescription": "Agent Desk는 외장 디스크에 있는 저장소에서 에이전트를 실행해요.",
        "NSNetworkVolumesUsageDescription": "Agent Desk는 네트워크 드라이브에 있는 저장소에서 에이전트를 실행해요."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15"
  }
}
